# Copy to .env. scripts/setup_database.py creates local random DB credentials.
APP_ENV=development
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=tance
DATABASE_PASSWORD=replace_with_your_local_password
DATABASE_NAME=tance_dev
TEST_DATABASE_NAME=tance_test
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Leave disabled until a provider, model and API key have been selected.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
